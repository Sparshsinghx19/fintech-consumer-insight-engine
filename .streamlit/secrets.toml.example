# Streamlit secrets for hosted mode (e.g. Streamlit Community Cloud).
#
# On Community Cloud, paste these lines into your app's Settings -> Secrets.
# For local testing, copy this file to .streamlit/secrets.toml (git-ignored).
# Never commit a real API key.
#
# Hosted mode is NOT fully local: questions and retrieved document passages
# are sent to Google's Gemini API to generate answers.

LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-3.8-flash"
GEMINI_THINKING_LEVEL = "low"
GEMINI_RETRY_ATTEMPTS = "3"

# Read-only public demo with rate-limited model calls.
PUBLIC_DEMO_MODE = "true"
DEMO_SESSION_REQUEST_LIMIT = "20"
DEMO_GLOBAL_REQUEST_LIMIT = "200"
DEMO_RATE_WINDOW_SECONDS = "3600"
