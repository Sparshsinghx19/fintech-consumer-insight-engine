# --- LLM provider ---
# "ollama" (default): fully local generation, no API key needed.
# "gemini": hosted generation via the Google Gemini API. NOT fully local -
#   questions and retrieved document passages are sent to Google.
LLM_PROVIDER=ollama

# --- Gemini (only used when LLM_PROVIDER=gemini) ---
# Put the real key in your .env (git-ignored) or Streamlit secrets; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT=120

# --- Public demo mode (keep false for local development) ---
# true: visitors can't upload/delete documents or reindex, and model calls
# are rate-limited per browser session and per server process.
PUBLIC_DEMO_MODE=false
DEMO_SESSION_REQUEST_LIMIT=20
DEMO_GLOBAL_REQUEST_LIMIT=200
DEMO_RATE_WINDOW_SECONDS=3600

# --- Ollama / local LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT=120

# --- Local embeddings (Hugging Face / Sentence-Transformers, runs on-device) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Chunking / retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_CONTEXT_CHARS=12000

# --- Storage paths ---
DATA_DIR=data/raw
PROCESSED_DIR=data/processed
VECTORSTORE_DIR=vectorstore
CHROMA_COLLECTION=fintech_research

# --- Misc ---
LOG_LEVEL=INFO
